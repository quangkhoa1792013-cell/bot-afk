# ===== Bot-mail configuration =====
# Copy file này thành .env rồi điền giá trị của bạn:
#   cp .env.example .env
# LƯU Ý: .env đã có trong .gitignore - không bao giờ commit file chứa token/mật khẩu thật.
# Các biến đã điền sẵn là giá trị chuẩn - không cần đổi. Chỉ để trống các biến mật khi không dùng.

# --- SMTP Receiver (nhận mail, port 25) ---
# Port chuẩn SMTP. Nếu chạy không có sudo, đổi thành port cao (2525) để thử nghiệm
SMTP_PORT=25
# Interface để bind; 0.0.0.0 = nhận từ mọi nơi (cần khi router forward)
SMTP_HOST=0.0.0.0

# Domain nhận mail: chỉ nhận mail tới <ten>@MAIL_DOMAIN
MAIL_DOMAIN=khoablabla.ddns.net

# Chế độ catch-all: true = nhận mail tới MỌI địa chỉ (kể cả domain lạ).
# Mặc định false = chỉ nhận mail tới các địa chỉ đã TẠO trên dashboard.
CATCH_ALL=false

# --- Web Dashboard / API ---
WEB_HOST=0.0.0.0
WEB_PORT=3000

# --- Storage (mặc định ./data) ---
# DATA_DIR=/home/khoablabla/bot-mail/data

# --- Cleanup ---
# Xóa mail tự động sau số giờ này (mặc định 24h)
MAIL_TTL_HOURS=24
# Janitor chạy kiểm tra mỗi bao nhiêu phút
CLEANUP_INTERVAL_MIN=60

# --- Telegram Bot (tạo qua @BotFather, chatId qua @userinfobot) ---
# Để trống nếu không cần báo Telegram (có thể nhập trên Dashboard -> Cài đặt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bảo mật (optional) ---
API_SECRET=

# --- SMTP Outbound (GỬI mail từ dashboard, port 587/465 của provider) ---
# Để trống nếu không gửi mail (có thể nhập trên Dashboard -> Cài đặt)
SMTP_OUT_HOST=
SMTP_OUT_PORT=587
SMTP_OUT_SECURE=false
SMTP_OUT_USER=
SMTP_OUT_PASS=
SMTP_OUT_FROM_NAME=