[DEFAULT]
# Ban sau 5 lan sai trong 10 phut -> khoa 67d (giu harsh hien tai)
bantime = 67d
findtime = 10m
maxretry = 5
# backend systemd de doc journald (Arch)
backend = systemd

[sshd]
enabled = true
port = ssh
# logpath tu dong theo backend systemd, giu de tuong thich
logpath = %(sshd_log)s
backend = %(sshd_backend)s
# tang harsh neu muon 67d thi doi bantime = 67d o tren
