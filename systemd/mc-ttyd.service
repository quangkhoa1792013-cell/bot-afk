[Unit]
Description=ttyd noi bo 2014 (base /terminal/ -> tmux mc_bot) cho web 1-port 2013
After=mc-download.service

[Service]
ExecStart=/usr/bin/ttyd -i 127.0.0.1 -p 2014 -b /terminal/ -t fontSize=15 -W bash -c "while true; do tmux attach-session -t mc_bot 2>/dev/null || (clear; echo '=== CHO BOT (mc_bot chua chay) ==='; echo ''; echo 'Chay bot:  bot start <ten>   |   bot status all'; echo 'Xem bot truc tiep:  tmux attach -t mc_bot'; sleep 5); done"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
