#!/usr/bin/env bash
# ============================================================================
#  bot — quản lý MCC bot (bản v2)
#
#  - Bot có thể nằm ở BẤT KỲ thư mục nào. Danh sách bot (registry) nằm ở:
#        $PROJECT_DIR/bots.conf        (mỗi dòng:  ten|thu_muc_chua_<ten>.sh)
#    File này sửa tay được; 'bot add' / 'bot remove' cũng ghi vào đó.
#    Lần đầu chạy, bot tự quét (bots/, */bots/, */bots/*/bots/) và seed registry.
#
#  - Mỗi bot gồm (không cần đủ hết, có gì dùng nấy):
#        <tên>.sh          script chính (loop MinecraftClient)
#        <tên>_tmux.sh     script tạo tmux (nếu có, 'start' sẽ chạy script này --bg)
#        <tên>.ini         config MCC (đọc INI_SRC trong .sh nếu có)
#        scripts/login_<tên>.txt   (tìm ở $PROJECT_DIR/scripts hoặc <botroot>/scripts)
# ============================================================================

BOT_VERSION="2.1"

# --- tự resolve project gốc (chạy đúng cả khi gọi qua symlink) --------------
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
PROJECT_DIR="${BOT_PROJECT_DIR:-$(cd -P "$(dirname "$SOURCE")/.." && pwd)}"
if [ -z "${BOT_PROJECT_DIR:-}" ] && [ -f "$HOME/.local/share/bot-afk/install.sh" ] \
    && [ "$(cd -P "$(dirname "$SOURCE")" && pwd)" = "$HOME/.local/bin" ]; then
    PROJECT_DIR="$HOME/.local/share/bot-afk"
fi
# fallback: nếu thư mục không giống project (ví dụ bị copy đi chỗ khác)
if [ "$PROJECT_DIR" != "$HOME/.local/share/bot-afk" ] \
    && [ ! -f "$PROJECT_DIR/download.py" ] && [ ! -d "$PROJECT_DIR/bots" ] && [ -d "$HOME/geasf" ]; then
    PROJECT_DIR="$HOME/geasf"
fi

REG_FILE="${BOT_REG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/bot-afk/bots.conf}"
LEGACY_REG_FILE="$PROJECT_DIR/bots.conf"
if [ ! -f "$REG_FILE" ] && [ -f "$LEGACY_REG_FILE" ]; then
    mkdir -p "$(dirname "$REG_FILE")"
    cp "$LEGACY_REG_FILE" "$REG_FILE"
fi
DL_FLAG="$PROJECT_DIR/.download_on"
DOWNLOAD_PY="$PROJECT_DIR/download.py"
DL_PORT="${DOWNLOAD_PORT:-2013}"
DEFAULT_TTYD_PORT=2014
SHARED_SESSION="mc_bot"

# --- màu (chỉ khi stdout là tty) --------------------------------------------
if [ -t 1 ]; then
    R=$'\033[0;31m'; G=$'\033[0;32m'; Y=$'\033[0;33m'; B=$'\033[0;34m'
    M=$'\033[0;35m'; C=$'\033[0;36m'; D=$'\033[2m'; BR=$'\033[1m'; X=$'\033[0m'
else
    R=''; G=''; Y=''; B=''; M=''; C=''; D=''; BR=''; X=''
fi
say()  { printf '%b\n' "$*"; }
ok()   { printf "${G}[✓]${X} %b\n" "$*"; }
warn() { printf "${Y}[!]${X} %b\n" "$*"; }
err()  { printf "${R}[✗]${X} %b\n" "$*" >&2; }
dim()  { printf "${D}%b${X}\n" "$*"; }
hr()   { printf -- "${D}--------------------------------------------------------------${X}\n"; }

FORCE_YES=0
confirm() { # confirm "câu hỏi" → 0 nếu yes
    local ans
    [ "$FORCE_YES" = 1 ] && return 0
    if [ ! -t 0 ]; then warn "non-interactive → hủy (thêm -y để xác nhận sẵn)"; return 1; fi
    read -r -p "$1 (y/N): " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# ============================================================================
#  REGISTRY  (bots.conf: "ten|dir" mỗi dòng, # là comment)
# ============================================================================
REG_NAMES=(); REG_DIRS=()

reg_load() {
    REG_NAMES=(); REG_DIRS=()
    [ -f "$REG_FILE" ] || return 0
    local line name dir
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"; line="$(trim "$line")"
        [ -z "$line" ] && continue
        case "$line" in *\|*) ;; *) continue ;; esac
        name="$(trim "${line%%|*}")"; dir="$(trim "${line#*|}")"
        [ -z "$name" ] && continue
        reg_has "$name" && continue
        REG_NAMES+=("$name"); REG_DIRS+=("$dir")
    done < "$REG_FILE"
}
reg_index() {
    local i
    for i in "${!REG_NAMES[@]}"; do
        [ "${REG_NAMES[$i]}" = "$1" ] && { echo "$i"; return 0; }
    done
    echo "-1"; return 1
}
reg_has()  { [ "$(reg_index "$1")" -ge 0 ] 2>/dev/null; }
reg_dir()  {
    local i; i="$(reg_index "$1")" || return 1
    [ "$i" -ge 0 ] || return 1
    printf '%s\n' "${REG_DIRS[$i]}"
}
reg_set() { # reg_set name dir  (thêm hoặc cập nhật)
    local i; i="$(reg_index "$1")" || i=-1
    if [ "$i" -ge 0 ]; then REG_DIRS[$i]="$2"
    else REG_NAMES+=("$1"); REG_DIRS+=("$2"); fi
}
reg_del() {
    local i; i="$(reg_index "$1")" || return 0
    [ "$i" -ge 0 ] || return 0
    unset 'REG_NAMES[i]'; unset 'REG_DIRS[i]'
    REG_NAMES=("${REG_NAMES[@]}"); REG_DIRS=("${REG_DIRS[@]}")
}
reg_save() {
    mkdir -p "$(dirname "$REG_FILE")"
    {
        echo "# bots.conf — registry của lệnh 'bot' (mỗi dòng: ten|thu_muc_chua_<ten>.sh)"
        echo "# Sửa tay được. 'bot add/remove' cũng ghi file này. # = comment."
        local i
        for i in "${!REG_NAMES[@]}"; do
            echo "${REG_NAMES[$i]}|${REG_DIRS[$i]}"
        done
    } > "$REG_FILE"
}

# --- quét filesystem để seed registry (chỉ thêm, không bao giờ tự xóa) ------
scan_fs_bots() { # in ra "name|dir"
    local f b d seen="|"
    for f in "$PROJECT_DIR"/bots/*.sh \
             "$PROJECT_DIR"/*/bots/*.sh \
             "$PROJECT_DIR"/*/*/bots/*.sh; do
        [ -e "$f" ] || continue
        b="$(basename "$f" .sh)"
        case "$b" in *_tmux|*_backup|*_old|test_*) continue ;; esac
        case "$seen" in *"|$b|"*) continue ;; esac
        d="$(cd "$(dirname "$f")" && pwd)"
        printf '%s|%s\n' "$b" "$d"
        seen="$seen$b|"
    done
}
registry_seed() {
    # Respect explicit removals once a registry has been created.
    [ -f "$REG_FILE" ] && return 0
    local line name dir changed=0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        name="${line%%|*}"; dir="${line#*|}"
        if reg_has "$name"; then continue; fi
        reg_set "$name" "$dir"; changed=1
        say "${D}[*] registry: phát hiện bot mới '${BR}$name${X}${D}' ($dir) → đã thêm${X}"
    done < <(scan_fs_bots)
    [ "$changed" = 1 ] && reg_save
    return 0
}

# ============================================================================
#  RESOLVE thông tin từng bot (mọi thứ suy ra từ name + dir)
# ============================================================================
bot_sh()     { local d; d="$(reg_dir "$1")" && printf '%s/%s.sh\n' "$d" "$1"; }
bot_tmux_sh(){ local d; d="$(reg_dir "$1")" && printf '%s/%s_tmux.sh\n' "$d" "$1"; }
bot_ini() {  # ưu tiên INI_SRC khai báo trong <tên>.sh, rồi tới các vị trí quen thuộc
    local name="$1" d src f
    d="$(reg_dir "$name")" || return 1
    src="$(grep -oP '^INI_SRC="\K[^"]+' "$d/$name.sh" 2>/dev/null | head -1)"
    if [ -n "$src" ]; then
        for f in "$PROJECT_DIR/$src" "$d/../$src" "$d/$src"; do
            [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
        done
    fi
    for f in "$d/$name.ini" "$d/../$name.ini" "$PROJECT_DIR/$name.ini"; do
        [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}
bot_login() { # script login: project/scripts hoặc <botroot>/scripts
    local name="$1" d f
    d="$(reg_dir "$name")" || return 1
    for f in "$PROJECT_DIR/scripts/login_$name.txt" "$d/../scripts/login_$name.txt"; do
        [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}
bot_account() {
    local d; d="$(reg_dir "$1")" || return 1
    grep -oP '^ACCOUNT="\K[^"]+' "$d/$1.sh" 2>/dev/null | head -1
}
bot_server() {
    local d; d="$(reg_dir "$1")" || return 1
    grep -oP '^SERVER="\K[^"]+' "$d/$1.sh" 2>/dev/null | head -1
}
bot_ttyd_port() {
    local t; t="$(bot_tmux_sh "$1")" || { echo "$DEFAULT_TTYD_PORT"; return 0; }
    grep -oP '^TTYD_PORT=\K[0-9]+' "$t" 2>/dev/null | head -1 || true
    echo ""
}
# (helper trên in thừa dòng trống — dùng bản gọn này)
port_of() { # port_of <file> <key> <default>
    local v=""
    [ -f "$1" ] && v="$(grep -oP "^$2=\K[0-9]+" "$1" 2>/dev/null | head -1)"
    [ -n "$v" ] && { echo "$v"; return 0; }
    echo "$3"
}

# --- tmux -------------------------------------------------------------------
sess_of() { # in "session" hoặc "session:winidx" nếu bot đang chạy
    local name="$1" s="mc_$name" hit wname
    if tmux has-session -t "=$s" 2>/dev/null; then echo "$s"; return 0; fi
    # bot chạy dưới dạng window trong session chung: khớp command HOẶC tên window
    hit="$(tmux list-panes -a -F '#{session_name}|#{window_index}|#{window_name}|#{pane_start_command}' 2>/dev/null \
        | awk -F'|' -v n="$name" '$1=="'"$SHARED_SESSION"'" && ($4 ~ "(^|/)" n "\\.sh( |$|\")" || $3==n) {print $1":"$2; exit}')"
    [ -n "$hit" ] && { echo "$hit"; return 0; }
    hit="$(tmux list-panes -a -F '#{session_name}|#{window_index}|#{pane_start_command}' 2>/dev/null \
        | grep -E "(^|/)${name}\.sh( |$|\")" | head -1 | cut -d'|' -f1,2 | tr '|' ':')"
    [ -n "$hit" ] && { echo "$hit"; return 0; }
    return 1
}
pane_pid_of() {
    local s; s="$(sess_of "$1")" || return 1
    tmux list-panes -t "$s" -F '#{pane_pid}' 2>/dev/null | head -1
}
mcc_pid_of() { # pid tiến trình MinecraftClient của bot
    local pp mcc
    pp="$(pane_pid_of "$1")"
    if [ -n "$pp" ]; then
        mcc="$(pgrep -P "$pp" -f 'MinecraftClient' 2>/dev/null | head -1)"
        [ -n "$mcc" ] && { echo "$mcc"; return 0; }
    fi
    pgrep -f "${1}_runtime\.ini" 2>/dev/null | head -1
}
ttyd_pid_for() { # pid ttyd đang attach vào bot này (theo mc_<tên> trong cmdline)
    local name="$1" pid cl
    for pid in $(pgrep -x ttyd 2>/dev/null); do
        cl="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
        case "$cl" in *"mc_$name "*) echo "$pid"; return 0 ;; esac
    done
    return 1
}
ttyd_user_for() {
    local t; t="$(bot_tmux_sh "$1")" || return 1
    grep -oP '^TTYD_USER="\K[^"]*' "$t" 2>/dev/null | head -1
}
dl_pid() { pgrep -f 'download\.py' 2>/dev/null | head -1; }

# --- url --------------------------------------------------------------------
lan_ip() {
    local ip
    ip="$(ip -4 addr show scope global 2>/dev/null | grep -oP 'inet \K[\d.]+' | head -1)"
    [ -z "$ip" ] && ip="127.0.0.1"
    echo "$ip"
}
public_url() {
    local cf="$PROJECT_DIR/caddy/Caddyfile" dom=""
    if [ -f "$cf" ]; then
        dom="$(grep -oE '[a-z0-9.-]+\.(ddns\.net|duckdns\.org)' "$cf" | head -1)"
        [ -z "$dom" ] && dom="$(grep -oE '^[[:space:]]*[a-z0-9][a-z0-9.-]+\.[a-z]{2,}[[:space:]]*\{' "$cf" | head -1 | tr -d ' {')"
    fi
    if [ -n "$dom" ]; then echo "https://$dom"
    else echo "http://$(lan_ip):$DL_PORT"; fi
}

# ============================================================================
#  LỆNH
# ============================================================================
cmd_help() {
    cat <<HELP
${BR}GIỚI THIỆU${X}
    bot — quản lý các bot Minecraft trên máy này.

${BR}CÁCH DÙNG${X}
    bot [LỆNH] [TUỲ CHỌN]... [TÊN_BOT|all]...

${BR}BẠN CÓ THỂ LÀM GÌ?${X}
    Bật, dừng và theo dõi bot; thêm bot có sẵn; sửa cấu hình; hoặc quản lý
    trang tải file và đường hầm truy cập. Mỗi bot có thể nằm ở một thư mục
    riêng. Danh sách bot được lưu tại: ${C}$REG_FILE${X}

${BR}CÁC LỆNH${X}
    ${C}start${X}   [-f] <bot|all>...  Bật bot chỉ định hoặc tất cả
                              (-f: dừng phiên cũ rồi khởi động lại)
                              Các bot chạy ở cửa sổ riêng trong tmux $SHARED_SESSION
    ${C}stop${X}    [-a] [-y] <bot|all>...
                              Dừng bot được chọn; các bot khác vẫn chạy.
                              all: dừng tất cả bot, giữ trang tải file.
                              -a: dừng tất cả bot, trang tải file và ttyd.
                              -y: bỏ qua câu hỏi xác nhận của -a.
    ${C}restart${X} <bot|all>...   Khởi động lại bot; khi chọn all, mỗi bot cách nhau 3 giây.
    ${C}autostart${X} <on|off> <bot>  Bật hoặc tắt tự chạy khi khởi động máy.
    ${C}list, ls${X}                Xem danh sách bot.
    ${C}status${X} [bot|all]       Xem bot nào đang chạy và các dịch vụ liên quan.
    ${C}add${X}    [file.sh|dir]    Thêm bot có sẵn hoặc tạo bot từ đầu.
                              Không nhập đường dẫn: chương trình sẽ hỏi bạn.
                              File .txt: tạo bot từ script đăng nhập.
    ${C}remove,rm${X} <bot|all> [--purge]
                              Gỡ bot khỏi danh sách. Thêm --purge để xóa cả
                              các file và dịch vụ liên quan sau khi xác nhận.
    ${C}download${X} <on|off|status|stop>
                              Quản lý trang web ở cổng :$DL_PORT.
                              / là trang chính, /terminal/ mở terminal,
                              /download dùng để tải file. stop tắt web và ttyd.
    ${C}tunnel${X} <on|off|status> Tunnel trycloudflare → internet vào :$DL_PORT
                              Mở hoặc tắt đường hầm truy cập qua Cloudflare.
                              Địa chỉ sẽ thay đổi mỗi lần mở lại. Lệnh off chỉ
                              tắt đường hầm do bot tạo; log ở $TUNNEL_LOG.
    ${C}edit${X}   [bot|all]        Sửa config: account/server/ini/script/
                              ttyd/port/đổi tên... (menu)
    ${C}info${X}   [bot|all]        Xem cấu hình và trạng thái của bot.
    ${C}attach${X} [bot]            Vào tmux (không tên → session chung)
    ${C}doctor${X}                 Kiểm tra những vấn đề thường gặp.
    ${C}help${X}                   Trợ giúp này

${BR}LỆNH VIẾT TẮT${X}
    ls=list   st|stat=status   rm|del=remove   dl=download   h|?=help
    rst=restart   tn=tunnel

${BR}MẶC ĐỊNH${X}
    bot                nếu có đúng 1 bot → start nó, ngược lại → list
    bot <tên>          = bot start <tên>

${BR}FILE LIÊN QUAN${X}
    $REG_FILE      registry: mỗi dòng "tên|thư_mục_chứa_<tên>.sh"
    $DL_FLAG   cờ bật /download
    $TUNNEL_PID_FILE   pid tunnel do 'bot tunnel on' quản

${BR}VÍ DỤ${X}
    bot start geasf
    bot start all
    bot stop geasf          # dừng geasf + tmux/ttyd của nó, bot khác giữ nguyên
    bot stop all
    bot stop -a             # tắt sạch: mọi bot + web download + ttyd
    bot restart geasf       # khởi động lại 1 bot
    bot restart all         # khởi động lại tất cả (cách nhau 3s)
    bot add                 # hỏi kiểu: 1 cài mới / 2 ghi path bot có sẵn
    bot add /path/thu_muc   # ghi path nhanh (thư mục chứa đúng 1 file <tên>.sh)
    bot add ./login.txt     # tạo bot mới từ file script login (.txt)
    bot status all
    bot download on
    bot tunnel on           # mở tunnel internet → :$DL_PORT, in URL
    bot edit geasf
    bot info all
HELP
}

fmt_size() { du -h "$1" 2>/dev/null | cut -f1; }
fmt_time() { stat -c '%y' "$1" 2>/dev/null | cut -d. -f1; }
short_path() { local p="${1//\/\/\//\/}"; echo "${p#"$PROJECT_DIR"/}"; }

cmd_list() {
    reg_load
    local i n d run acc srv missing=""
    say "${BR}Danh sách bot${X} (${D}lưu tại: $(short_path "$REG_FILE")${X})"
    hr
    printf "${BR}%-10s %-8s %-12s %-10s %s${X}\n" "TÊN" "RUN" "ACCOUNT" "SERVER" "DIR/FILE"
    for i in "${!REG_NAMES[@]}"; do
        n="${REG_NAMES[$i]}"; d="${REG_DIRS[$i]}"
        if [ -f "$d/$n.sh" ]; then missing=""
        else missing="${Y} ⚠thiếu $n.sh${X}"; fi
        local runf
        if [ -n "$(sess_of "$n")" ]; then printf -v runf '%-7s' "on";  runf="${G}${runf}${X}"
        else printf -v runf '%-7s' "off"; runf="${D}${runf}${X}"; fi
        acc="$(bot_account "$n")"; [ -z "$acc" ] && acc="-"
        srv="$(bot_server "$n")";  [ -z "$srv" ] && srv="-"
        printf "%-10s %s %-12s %-10s %s%s\n" "$n" "$runf" "$acc" "$srv" "${D}$(short_path "$d")/${X}$n.sh" "$missing"
    done
    [ "${#REG_NAMES[@]}" = 0 ] && say "  ${D}Chưa có bot nào. Dùng 'bot add' để thêm bot.${X}"
    hr
    dim "  start: bot start <tên>|all   •   restart: bot restart <tên>|all"
    dim "  trạng thái: bot status all   •   chi tiết: bot info <tên>   •   tunnel: bot tunnel on"
}

cmd_status() {
    reg_load
    local targets=() a
    for a in "$@"; do
        case "$a" in all|ALL) targets+=("${REG_NAMES[@]}") ;; *) targets+=("$a") ;; esac
    done
    [ ${#targets[@]} = 0 ] && targets=("${REG_NAMES[@]}")
    local n d run pid sess td dirshort
    printf "${BR}%-10s %-5s %-8s %-14s %-6s %s${X}\n" "TÊN" "RUN" "PID" "SESSION" "TTYD" "DIR"
    for n in "${targets[@]}"; do
        if ! reg_has "$n"; then err "không có bot '$n' trong danh sách"; continue; fi
        d="$(reg_dir "$n")"; dirshort="$(short_path "$d")"
        sess="$(sess_of "$n")"
        local runf
        if [ -n "$sess" ]; then
            printf -v runf '%-5s' "on";  runf="${G}${runf}${X}"
            pid="$(mcc_pid_of "$n")"; [ -z "$pid" ] && pid="$(pane_pid_of "$n")"
            [ -z "$pid" ] && pid="?"
        else
            pid="$(mcc_pid_of "$n")"
            if [ -n "$pid" ]; then
                printf -v runf '%-5s' "on"; runf="${Y}${runf}${X}"; sess="không tmux"
            else
                printf -v runf '%-5s' "off"; runf="${D}${runf}${X}"; pid="-"; sess="-"
            fi
        fi
        td="$(ttyd_pid_for "$n")"; [ -z "$td" ] && td="-"
        printf "%-10s %s %-8s %-14s %-6s %s\n" "$n" "$runf" "$pid" "$sess" "$td" "${D}$dirshort${X}"
    done
    [ ${#targets[@]} = 0 ] && say "  ${D}(không có bot — 'bot add' để thêm)${X}"
    # ---- hạ tầng chung ----
    local dlp ttyd_count flag
    dlp="$(dl_pid)"; ttyd_count="$(pgrep -x ttyd 2>/dev/null | wc -l)"
    [ -f "$DL_FLAG" ] && flag="${G}on${X}" || flag="${D}off${X}"
    hr
    if [ -n "$dlp" ]; then
        say "web: ${G}chạy${X} (pid $dlp) — 1 port :$DL_PORT   /download: $flag   ttyd nội bộ: $ttyd_count"
    else
        say "web: ${D}tắt${X} (:$DL_PORT không có server)   /download: $flag   ttyd nội bộ: $ttyd_count"
    fi
    local tpid tpurl
    tpid="$(tunnel_pid)"; [ -z "$tpid" ] && tpid="$(tunnel_pid_any)"
    tpurl="$(tunnel_url)"
    if [ -n "$tpid" ]; then
        say "tunnel: ${G}chạy${X} (pid $tpid) ${D}${tpurl:+— }$tpurl${X}"
    else
        say "tunnel: ${D}tắt${X} ${D}('bot tunnel on' để mở)${X}"
    fi
    dim "  Trang quản lý: $(public_url)/  •  Terminal: /terminal/  •  Tải file: /download"
}

cmd_info() {
    reg_load
    local targets=() a
    for a in "$@"; do
        case "$a" in all|ALL) targets+=("${REG_NAMES[@]}") ;; *) targets+=("$a") ;; esac
    done
    if [ ${#targets[@]} = 0 ]; then targets=("${REG_NAMES[@]}"); fi
    if [ ${#targets[@]} = 0 ]; then err "không có bot nào — 'bot add' để thêm"; return 1; fi
    local n d sh tsh ini login acc srv pp mcc tp td maint
    for n in "${targets[@]}"; do
        if ! reg_has "$n"; then err "không có bot '$n' trong danh sách (bot ls để xem)"; continue; fi
        d="$(reg_dir "$n")"; sh="$d/$n.sh"; tsh="$d/${n}_tmux.sh"
        ini="$(bot_ini "$n" 2>/dev/null)"; login="$(bot_login "$n" 2>/dev/null)"
        acc="$(bot_account "$n")"; srv="$(bot_server "$n")"
        say "${BR}═══ bot: $n ═══${X}"
        say "  Danh sách : ${G}có${X} (${D}$(short_path "$REG_FILE")${X})"
        say "  Thư mục   : $d"
        if [ -f "$sh" ]; then say "  Script    : $(short_path "$sh") ${D}($(fmt_size "$sh"), sửa $(fmt_time "$sh"))${X}"
        else say "  Script    : ${R}$sh — THIẾU${X}"; fi
        if [ -f "$tsh" ]; then say "  Tmux      : $(short_path "$tsh")"
        else say "  Tmux      : ${D}(không có — start sẽ chạy thẳng $n.sh)${X}"; fi
        if [ -n "$ini" ]; then
            say "  INI       : $(short_path "$ini") ${D}($(fmt_size "$ini"))${X}"
            say "  INI runtime: /tmp/${n}_runtime.ini ${D}(copy từ INI_SRC lúc chạy)${X}"
        else say "  INI       : ${Y}không tìm thấy${X}"; fi
        if [ -n "$login" ]; then
            say "  Login     : $(short_path "$login") ${D}($(wc -l < "$login" 2>/dev/null) dòng)${X}"
        else say "  Login     : ${D}(không có)${X}"; fi
        say "  Account   : ${M}${acc:-?}${X}    Server: ${C}${srv:-?}${X}"
        maint="$(grep -oP '^END_STR="\K[^"]+' "$sh" 2>/dev/null | head -1)"
        [ -n "$maint" ] && say "  Bảo trì   : ngủ tới $maint hằng ngày"
        pp="$(pane_pid_of "$n")"; mcc="$(mcc_pid_of "$n")"
        if [ -n "$(sess_of "$n")" ]; then
            say "  Session   : ${G}RUNNING${X} $(sess_of "$n") ${D}(pane=$pp, mcc=${mcc:-?})${X}"
        else
            say "  Session   : ${D}không chạy${X} (tên tmux dự kiến: mc_$n)"
        fi
        td="$(ttyd_pid_for "$n")"
        if [ -n "$td" ]; then
            say "  TTYD      : pid $td :$(port_of "$tsh" TTYD_PORT "$DEFAULT_TTYD_PORT") ${D}(user: $(ttyd_user_for "$n"))${X}"
        else
            say "  TTYD      : ${D}không chạy${X}"
        fi
        local dlp; dlp="$(dl_pid)"
        if [ -n "$dlp" ]; then
            say "  Web       : ${G}chạy${X} pid $dlp — 1 port :$DL_PORT   /download: $([ -f "$DL_FLAG" ] && echo on || echo off)"
        else
            say "  Web       : ${D}tắt${X} ${D}('bot download on' để mở)${X}"
        fi
        say "  URL       : $(public_url)/ ${D}• /terminal/ • /download${X}"
        say ""
    done
}

start_one() { # start_one <tên> [force]
    local name="$1" force="${2:-0}" d sh sess
    d="$(reg_dir "$name")" || { err "không có bot '$name' ('bot ls' để xem danh sách)"; return 1; }
    sh="$d/$name.sh"
    if [ ! -f "$sh" ]; then
        err "bot '$name' thiếu file $sh"
        dim "    file đã xóa? 'bot remove $name' để dọn registry, 'bot add' để thêm lại"
        return 1
    fi
    sess="$(sess_of "$name")"
    if [ -n "$sess" ]; then
        if [ "$force" = 1 ]; then
            warn "Bot '$name' đang chạy. Đang dừng phiên cũ để khởi động lại."
            stop_one "$name" || return 1
        else
            warn "Bot '$name' đang chạy rồi. Dùng 'bot restart $name' nếu bạn muốn khởi động lại."
            return 0
        fi
    fi
    say "${BR}▶ Đang khởi động $name...${X}"
    local launch
    printf -v launch 'bash %q %q %q' "$PROJECT_DIR/bin/bot_tmux_run.sh" "$name" "$sh"
    if tmux has-session -t "=$SHARED_SESSION" 2>/dev/null; then
        tmux new-window -t "$SHARED_SESSION" -n "$name" "$launch" \
            || { err "không tạo được window cho $name trong $SHARED_SESSION"; return 1; }
    else
        tmux new-session -d -s "$SHARED_SESSION" -n "$name" "$launch" \
            || { err "không tạo được session chung $SHARED_SESSION"; return 1; }
    fi
    tmux set-option -t "$SHARED_SESSION" allow-rename off 2>/dev/null
    sleep 1
    if [ -n "$(sess_of "$name")" ]; then
        ok "$name đã khởi động. Dùng 'bot attach $name' để xem."
    else
        warn "$name vừa thoát sau khi khởi động. Thử chạy 'bash $sh' để xem lỗi."
    fi
}
cmd_start() {
    reg_load
    local force=0 targets=() a
    for a in "$@"; do
        case "$a" in
            -f|--force|-y) force=1 ;;
            all|ALL) targets+=("${REG_NAMES[@]}") ;;
            *) targets+=("$a") ;;
        esac
    done
    if [ ${#targets[@]} = 0 ]; then
        if [ "${#REG_NAMES[@]}" = 1 ]; then targets=("${REG_NAMES[@]}")
        else err "dùng: bot start [-f] <bot|all>"; cmd_list; return 1; fi
    fi
    local n rc=0 first=1
    for n in "${targets[@]}"; do
        # nhiều bot bật cùng lúc → mỗi con cách 3s rồi vào (tránh login dồn bị kick)
        if [ "$first" = 0 ]; then
            say "${D}Đợi 3 giây trước khi khởi động bot tiếp theo...${X}"
            sleep 3
        fi
        first=0
        start_one "$n" "$force" || rc=1
    done
    return $rc
}

stop_system_service() {
    if [ -t 0 ]; then sudo systemctl stop "$1"
    else sudo -n systemctl stop "$1"; fi
}

service_needs_stop() {
    local state unit="${@: -1}" scope=()
    [ "$1" = --user ] && scope=(--user)
    state="$(systemctl "${scope[@]}" show "$unit" --property=ActiveState --value 2>/dev/null)" || return 1
    case "$state" in active|activating|reloading|deactivating) return 0 ;; *) return 1 ;; esac
}

stop_bot_services() {
    local name="$1" unit
    for unit in "mc-$name.service" "mc-$name-tmux.service"; do
        if service_needs_stop --user "$unit"; then
            systemctl --user stop "$unit" || { err "Không dừng được dịch vụ $unit của người dùng."; return 1; }
        fi
        if service_needs_stop "$unit"; then
            stop_system_service "$unit" || { err "Không dừng được dịch vụ hệ thống $unit. Hãy kiểm tra quyền sudo."; return 1; }
        fi
    done
}

stop_web_services() {
    local unit
    for unit in mc-download.service mc-ttyd.service; do
        if service_needs_stop --user "$unit"; then
            systemctl --user stop "$unit" || { err "Không dừng được dịch vụ $unit của người dùng."; return 1; }
        fi
        if service_needs_stop "$unit"; then
            stop_system_service "$unit" || { err "Không dừng được dịch vụ hệ thống $unit. Hãy kiểm tra quyền sudo."; return 1; }
        fi
    done
}

stop_one() { # dừng bot + MỌI THỨ LIÊN QUAN đến nó (bot khác không bị đụng tới)
    local name="$1" d sess w pid cl stopped=0
    d="$(reg_dir "$name")" 2>/dev/null
    stop_bot_services "$name" || return 1
    # 1) session riêng mc_<tên> HOẶC window trong session chung
    sess="$(sess_of "$name")"
    if [ -n "$sess" ]; then
        case "$sess" in
            *:*) # session:window → chỉ kill window đó (bot khác trong session chung giữ nguyên)
                tmux kill-window -t "$sess" 2>/dev/null \
                    && { ok "  Đã đóng cửa sổ của $name ($sess)."; stopped=1; } ;;
            *)   tmux kill-session -t "=$sess" 2>/dev/null \
                    && { ok "  Đã đóng phiên $sess của $name."; stopped=1; } ;;
        esac
    fi
    # 2) window của bot nằm chung session khác (vd mc_bot)
    w="$(tmux list-panes -a -F '#{session_name}|#{window_index}|#{pane_start_command}' 2>/dev/null \
        | grep -E "(^|/)${name}\.sh( |\$|\")" | cut -d'|' -f1,2 | tr '|' ':')"
    if [ -n "$w" ]; then
        while IFS= read -r t; do
            [ -n "$t" ] || continue
            tmux kill-window -t "$t" 2>/dev/null && { ok "  Đã đóng cửa sổ của $name ($t)."; stopped=1; }
        done <<< "$w"
    fi
    # 3) tiến trình MCC còn sót (theo ini runtime của bot)
    if pgrep -f "${name}_runtime\.ini" >/dev/null 2>&1; then
        pkill -f "${name}_runtime\.ini" 2>/dev/null && { ok "  Đã dừng tiến trình còn lại của $name."; stopped=1; }
    fi
    # 4) ttyd đang attach vào bot này
    for pid in $(pgrep -x ttyd 2>/dev/null); do
        cl="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
        case "$cl" in
            *"mc_$name "*|*"mc_$name")
                kill "$pid" 2>/dev/null && { ok "  kill ttyd (pid $pid) của $name"; stopped=1; } ;;
        esac
    done
    if [ "$stopped" = 0 ]; then
        dim "  $name đã dừng hoặc không có phiên nào đang chạy."
    fi
    return 0
}
stop_everything() { # -a: toàn bộ luôn — mọi bot + web + ttyd + mọi session mc_*
    confirm "TẮT TOÀN BỘ? (mọi bot + web download + ttyd + mọi tmux mc_*)" || return 1
    local n s rc=0
    for n in "${REG_NAMES[@]}"; do
        say "${BR}■ stop $n${X}"; stop_one "$n" || rc=1
    done
    [ "$rc" = 0 ] || { err "chưa dừng được tất cả service"; return 1; }
    stop_web_services || return 1
    # session mc_* còn sót (kể cả không nằm trong registry) + session chung
    for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep -E '^mc_'); do
        tmux kill-session -t "=$s" 2>/dev/null && ok "tmux kill-session $s"
    done
    pkill -x ttyd 2>/dev/null && ok "kill toàn bộ ttyd"
    pkill -f 'download\.py' 2>/dev/null && ok "kill web download"
    rm -f "$DL_FLAG"
    ok "Đã dừng tất cả bot, trang tải file và ttyd."
}
cmd_stop() {
    reg_load
    local all_infra=0 targets=() a
    for a in "$@"; do
        case "$a" in
            -a|--all|-A) all_infra=1 ;;
            -y|--yes) FORCE_YES=1 ;;
            all|ALL) targets+=("${REG_NAMES[@]}") ;;
            *) targets+=("$a") ;;
        esac
    done
    if [ "$all_infra" = 1 ]; then stop_everything; return $?; fi
    if [ ${#targets[@]} = 0 ]; then
        err "dùng: bot stop [-a] [-y] <bot|all>"
        dim "  bot stop <tên>   → dừng bot đó + mọi thứ liên quan (bot khác giữ nguyên)"
        dim "  bot stop all     → dừng tất cả bot (giữ web download)"
        dim "  bot stop -a      → tắt toàn bộ luôn (bot + web + ttyd)"
        cmd_list; return 1
    fi
    local n rc=0
    for n in "${targets[@]}"; do
        if ! reg_has "$n"; then err "không có bot '$n' trong danh sách"; rc=1; continue; fi
        say "${BR}■ stop $n${X}"; stop_one "$n" || rc=1
    done
    return "$rc"
}

# ============================================================================
#  RESTART  (stop rồi start lại — 1 bot hoặc all, stagger như start)
# ============================================================================
cmd_restart() {
    reg_load
    local force=1 targets=() a
    for a in "$@"; do
        case "$a" in
            -f|--force|-y) force=1 ;;
            all|ALL) targets+=("${REG_NAMES[@]}") ;;
            *) targets+=("$a") ;;
        esac
    done
    if [ ${#targets[@]} = 0 ]; then
        if [ "${#REG_NAMES[@]}" = 1 ]; then targets=("${REG_NAMES[@]}")
        else err "dùng: bot restart <bot|all>"; cmd_list; return 1; fi
    fi
    local n rc=0 first=1
    for n in "${targets[@]}"; do
        if ! reg_has "$n"; then err "không có bot '$n' trong danh sách"; rc=1; continue; fi
        say "${BR}⟳ Đang khởi động lại $n...${X}"
        stop_one "$n" || { rc=1; continue; }
        # nhiều bot restart cùng lúc → cách nhau 3s như 'start' (tránh login dồn bị kick)
        if [ "$first" = 0 ]; then
            say "${D}Đợi 3 giây trước khi khởi động bot tiếp theo...${X}"
            sleep 3
        fi
        first=0
        start_one "$n" "$force" || rc=1
    done
    return $rc
}

cmd_add() { # bot add [path] — không path: hỏi kiểu (1=cài mới, 2=ghi path bot có sẵn)
    reg_load
    local p="$1"
    if [ -z "$p" ]; then
        say ""
        say "${B}Bạn muốn thêm bot như thế nào?${X}"
        say "  ${C}1${X}) Tạo bot mới. Bộ cài sẽ hỏi tên, server và script đăng nhập."
        say "  ${C}2${X}) Thêm bot đã có sẵn bằng đường dẫn đến file hoặc thư mục."
        local ans
        read -r -p "Chọn 1/2 (Enter = 1): " ans || ans=""
        if [ -z "$ans" ] && [ ! -t 0 ]; then # pipe EOF → không tự chạy installer
            err "dùng: bot add <file.sh|thư_mục>"
            dim "  Chọn file .sh của bot có sẵn, hoặc file .txt để tạo bot từ script đăng nhập."
            return 1
        fi
        if [ "$ans" = "2" ]; then
            read -r -p "Đường dẫn tới file ${BR}<tên>.sh${X} hoặc thư mục chứa file: " p || p=""
            [ -z "$p" ] && { err "Bạn chưa nhập đường dẫn."; return 1; }
        else
            if [ "$ans" = "1" ] && { [ ! -t 0 ] || [ ! -e /dev/tty ]; }; then
                err "Không có terminal tương tác để mở bộ cài."
                dim "  Bạn có thể thêm bot có sẵn bằng: bot add <file.sh|thư_mục>"
                return 1
            fi
            say "${D}Đang mở bộ cài. Nhấn Ctrl+C nếu bạn muốn hủy.${X}"
            bash "$PROJECT_DIR/install.sh"
            return $?
        fi
    fi
    # truyền .txt (file script login) → tạo bot mới qua installer --script
    case "$p" in
        *.txt)
            [ -f "${p/#\~/$HOME}" ] || { err "không thấy file '$p'"; return 1; }
            say "${D}Đang tạo bot từ script: $p${X}"
            bash "$PROJECT_DIR/install.sh" --script "$p"
            return $?
            ;;
    esac
    p="${p/#\~/$HOME}"
    # thư mục → tìm đúng 1 file .sh ứng viên
    if [ -d "$p" ]; then
        local c=() f
        for f in "$p"/*.sh; do
            [ -e "$f" ] || continue
            case "$(basename "$f" .sh)" in *_tmux|*_backup|*_old|test_*) continue ;; esac
            c+=("$f")
        done
        if [ ${#c[@]} = 1 ]; then p="${c[0]}"
        else err "'$p' phải chứa đúng 1 file <tên>.sh (thấy ${#c[@]})"; return 1; fi
    fi
    [ -f "$p" ] || { err "không thấy file '$p'"; return 1; }
    p="$(readlink -f "$p")"
    local name dir
    name="$(basename "$p" .sh)"
    case "$name" in *_tmux|*_backup|*_old|test_*) err "tên bot không hợp lệ: $name"; return 1 ;; esac
    dir="$(dirname "$p")"
    if reg_has "$name"; then
        local old; old="$(reg_dir "$name")"
        if [ "$old" = "$dir" ]; then warn "'$name' đã có trong danh sách rồi ($dir)"; return 0; fi
        warn "'$name' đã có với thư mục cũ: $old"
        confirm "Cập nhật sang $dir?" || return 1
    fi
    reg_set "$name" "$dir"; reg_save
    ok "Đã thêm bot '${BR}$name${X}'."
    dim "  Xem thông tin: bot info $name  •  Khởi động: bot start $name"
}

purge_one() { # xóa hẳn file + session + unit systemd của bot
    local name="$1" d sh tsh ini login f
    d="$(reg_dir "$name")" 2>/dev/null
    stop_one "$name" || return 1
    if [ -n "$d" ]; then
        sh="$d/$name.sh"; tsh="$d/${name}_tmux.sh"; ini="$(bot_ini "$name" 2>/dev/null)"
        for f in "$sh" "$tsh" "$ini" "/tmp/${name}_runtime.ini"; do
            [ -e "$f" ] || continue
            rm -f "$f" && ok "  rm $(short_path "$f")"
        done
        for f in "$PROJECT_DIR/scripts/login_$name.txt" "$d/../scripts/login_$name.txt"; do
            [ -f "$f" ] && { rm -f "$f" && ok "  rm $(short_path "$f")"; }
        done
    fi
    f="$HOME/.config/systemd/user/mc-$name.service"
    [ -f "$f" ] && { rm -f "$f" && ok "  rm $(short_path "$f")"; }
    if sudo -n true 2>/dev/null && [ -f "/etc/systemd/system/mc-$name.service" ]; then
        sudo rm -f "/etc/systemd/system/mc-$name.service" && ok "  rm /etc/systemd/system/mc-$name.service"
    fi
    systemctl --user daemon-reload 2>/dev/null
    return 0
}
cmd_remove() {
    reg_load
    local purge=0 targets=() a
    for a in "$@"; do
        case "$a" in --purge|-p) purge=1 ;; -y|--yes) FORCE_YES=1 ;; all|ALL) targets+=("${REG_NAMES[@]}") ;; *) targets+=("$a") ;; esac
    done
    if [ ${#targets[@]} = 0 ]; then err "dùng: bot remove <bot|all> [--purge]"; cmd_list; return 1; fi
    local n rc=0
    for n in "${targets[@]}"; do
        if ! reg_has "$n"; then err "không có bot '$n' trong danh sách"; rc=1; continue; fi
        if [ "$purge" = 1 ]; then
            confirm "XÓA HẲN bot '$n' (file + session + systemd)?" || { warn "bỏ qua $n"; continue; }
            purge_one "$n" || { rc=1; continue; }
            ok "đã xóa hẳn bot '$n'"
        else
            confirm "Gỡ '$n' khỏi danh sách? (file giữ nguyên)" || { warn "bỏ qua $n"; continue; }
            ok "đã gỡ '$n' khỏi danh sách ${D}(file vẫn còn — 'bot add' thêm lại được)${X}"
        fi
        reg_del "$n"
    done
    reg_save
    return $rc
}

ensure_web_stack() { # 1 PORT DUY NHẤT :2013 — ttyd chỉ nội bộ để proxy path /terminal/
    if ! ss -tlnp 2>/dev/null | grep -q ":$DL_PORT "; then
        say "[*] khởi động web :$DL_PORT (1 port duy nhất, bind ${BIND_HOST:-0.0.0.0}) ..."
        setsid nohup env BIND_HOST="${BIND_HOST:-0.0.0.0}" python3 "$DOWNLOAD_PY" \
            >> "/tmp/download-$DL_PORT.log" 2>&1 < /dev/null &
        disown 2>/dev/null
        sleep 1
    fi
    local tport="${TTYD_PORT:-$DEFAULT_TTYD_PORT}"
    if command -v ttyd >/dev/null 2>&1 && ! ss -tlnp 2>/dev/null | grep -q ":$tport "; then
        say "[*] khởi động ttyd NỘI BỘ :$tport ${D}(chỉ 127.0.0.1 — phục vụ path /terminal/ qua :$DL_PORT)${X} ..."
        setsid nohup ttyd -i 127.0.0.1 -p "$tport" -b /terminal/ -t fontSize=15 -W \
            bash -c "while true; do tmux attach-session -t $SHARED_SESSION 2>/dev/null || (clear; echo '=== CHỜ BOT ==='; sleep 5); done" \
            >> "/tmp/ttyd-$tport.log" 2>&1 < /dev/null &
        disown 2>/dev/null
        sleep 0.5
    fi
}
cmd_download() {
    local sub="${1:-status}" url pid
    url="$(public_url)"
    case "$sub" in
        on)
            touch "$DL_FLAG"
            ensure_web_stack
            if ss -tlnp 2>/dev/null | grep -q ":$DL_PORT "; then
                ok "1-port :$DL_PORT → $url/ ${D}• /terminal/${X} • ${BR}$url/download${X}"
            else
                err "Trang web chưa mở được ở cổng $DL_PORT. Hãy xem /tmp/download-$DL_PORT.log để tìm nguyên nhân."
                return 1
            fi
            ;;
        off)
            rm -f "$DL_FLAG"
            ok "/download đã TẮT ${D}(web vẫn chạy — / vào portal/ttyd; tắt hẳn server: 'bot download stop')${X}"
            ;;
        stop)
            stop_web_services || return 1
            pid="$(dl_pid)"
            if [ -n "$pid" ]; then
                kill "$pid" && ok "đã tắt web download (pid $pid)"
            else
                dim "Trang web hiện không chạy."
            fi
            local tport="${TTYD_PORT:-$DEFAULT_TTYD_PORT}" tp tcl
            for tp in $(pgrep -x ttyd 2>/dev/null); do
                tcl="$(tr '\0' ' ' < "/proc/$tp/cmdline" 2>/dev/null)"
                case "$tcl" in *"-p $tport "*)
                    kill "$tp" 2>/dev/null && ok "đã tắt ttyd (pid $tp, :$tport)" ;;
                esac
            done
            ;;
        status)
            pid="$(dl_pid)"
            if [ -f "$DL_FLAG" ]; then flag="${G}on${X}"; else flag="${D}off${X}"; fi
            local tport="${TTYD_PORT:-$DEFAULT_TTYD_PORT}"
            if [ -n "$pid" ]; then
                say "web     : ${G}chạy${X} (pid $pid) — ${BR}1 port duy nhất :$DL_PORT${X}"
            else
                say "web     : ${D}tắt${X} ${D}('bot download on' để mở)${X}"
            fi
            if ss -tlnp 2>/dev/null | grep -q ":$tport "; then
                say "ttyd    : ${G}nội bộ${X} :$tport ${D}(chỉ 127.0.0.1 — vào qua path /terminal/)${X}"
            else
                say "ttyd    : ${D}tắt${X} ${D}('bot download on' tự bật)${X}"
            fi
            say "/download: $flag ${D}('bot download on|off')${X}"
            say "paths   :"
            say "  $url/            ${D}→ portal${X}"
            say "  $url/terminal/   ${D}→ terminal (ttyd)${X}"
            say "  $url/download    ${D}→ tải file${X}"
            say "${D}  (muốn thêm service khác → thêm path trong download.py, KHÔNG mở port mới)${X}"
            ;;
        *) err "dùng: bot download <on|off|status|stop>"; return 1 ;;
    esac
}

# ============================================================================
#  TUNNEL  (cloudflared quick tunnel → internet vào :$DL_PORT, như mọi lệnh khác)
# ============================================================================
TUNNEL_LOG="/tmp/cloudflared-$DL_PORT.log"
TUNNEL_PID_FILE="$PROJECT_DIR/.tunnel_pid"
tunnel_pid() { # PID do 'bot tunnel on' quản (ghi ở .tunnel_pid, còn sống + đúng cloudflared)
    local pid cl
    [ -f "$TUNNEL_PID_FILE" ] || return 1
    pid="$(cat "$TUNNEL_PID_FILE" 2>/dev/null)"
    [ -n "$pid" ] || { rm -f "$TUNNEL_PID_FILE"; return 1; }
    [ -r "/proc/$pid/cmdline" ] || { rm -f "$TUNNEL_PID_FILE"; return 1; }
    cl="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    if [ -n "$cl" ] && [[ "$cl" == *cloudflared* ]] && [[ "$cl" == *":$DL_PORT"* ]]; then
        echo "$pid"; return 0
    fi
    rm -f "$TUNNEL_PID_FILE"   # pid chết rồi → dọn file cũ
    return 1
}
tunnel_pid_any() { # PID cloudflared BẤT KỲ (kể cả chạy tay ngoài bot)
    pgrep -x cloudflared 2>/dev/null | head -1
}
tunnel_url() { # URL trycloudflare mới nhất trong log
    [ -f "$TUNNEL_LOG" ] || return 1
    grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" 2>/dev/null | tail -1
}
cmd_tunnel() {
    reg_load
    local sub="${1:-status}" pid url
    case "$sub" in
        on)
            pid="$(tunnel_pid)"
            if [ -n "$pid" ]; then
                warn "Đường hầm đã chạy rồi (PID $pid)."
                url="$(tunnel_url)"
                [ -n "$url" ] && ok "$url"
                return 0
            fi
            if [ -n "$(tunnel_pid_any)" ]; then
                err "Đã có một tiến trình cloudflared chạy ngoài chương trình (PID $(tunnel_pid_any))."
                dim "  Hãy xem địa chỉ trong terminal đã mở đường hầm đó, hoặc dừng nó trước khi tạo đường hầm mới."
                return 1
            fi
            [ -n "$(dl_pid)" ] || ensure_web_stack
            if ! ss -tlnp 2>/dev/null | grep -q ":$DL_PORT "; then
                err "Trang web chưa mở ở cổng $DL_PORT. Hãy chạy 'bot download on' trước."
                return 1
            fi
            command -v cloudflared >/dev/null 2>&1 \
                || { err "chưa cài cloudflared — xem https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/"; return 1; }
            : > "$TUNNEL_LOG"
            say "Đang tạo đường hầm tới trang web ở cổng $DL_PORT..."
            setsid nohup cloudflared tunnel --protocol http2 \
                --url "http://localhost:$DL_PORT" \
                --no-autoupdate >> "$TUNNEL_LOG" 2>&1 < /dev/null &
            disown 2>/dev/null
            echo "$!" > "$TUNNEL_PID_FILE"
            # đợi URL xuất hiện trong log (tối đa ~15s)
            local i=0
            while [ $i -lt 30 ]; do
                sleep 0.5; i=$((i+1))
                url="$(tunnel_url)"; [ -n "$url" ] && break
            done
            if [ -n "$(tunnel_pid)" ] && [ -n "${url:-}" ]; then
                ok "tunnel đang chạy (pid $(tunnel_pid)) — log: $TUNNEL_LOG"
                say ""
                say "  ${BR}$url${X}   ${D}→ / • /terminal/ • /download${X}"
            elif [ -n "$(tunnel_pid)" ]; then
                ok "tunnel đang chạy (pid $(tunnel_pid)) — URL sẽ hiện trong $TUNNEL_LOG"
                dim "  xem: bot tunnel status"
            else
                err "cloudflared vừa thoát. Hãy xem $TUNNEL_LOG để tìm nguyên nhân."
                tail -5 "$TUNNEL_LOG" 2>/dev/null | sed 's/^/    /'
                return 1
            fi
            ;;
        off)
            pid="$(tunnel_pid)"
            if [ -z "$pid" ]; then
                if [ -n "$(tunnel_pid_any)" ]; then
                    warn "Có một đường hầm đang chạy ngoài chương trình; lệnh này sẽ không dừng nó."
                    dim "  Hãy dừng đường hầm đó trong terminal hoặc dịch vụ đã khởi chạy nó."
                else
                    dim "Hiện không có đường hầm nào đang chạy."
                fi
                return 0
            fi
            kill "$pid" 2>/dev/null && ok "đã tắt tunnel (pid $pid) ${D}— domain trycloudflare cũng hết (lần sau domain mới)${X}"
            # cloudflared tắt chậm (graceful) → chờ tối đa 5s, quá thì SIGKILL
            local i=0
            while [ $i -lt 10 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.5; i=$((i+1)); done
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null && warn "phải SIGKILL (pid $pid)"
            fi
            rm -f "$TUNNEL_PID_FILE"
            ;;
        status)
            pid="$(tunnel_pid)"; local any; any="$(tunnel_pid_any)"; url="$(tunnel_url)"
            if [ -n "$pid" ]; then
                say "tunnel : ${G}chạy${X} (pid $pid, do bot quản) ${D}— log: $TUNNEL_LOG${X}"
            elif [ -n "$any" ]; then
                say "tunnel : ${Y}chạy tay ngoài bot${X} (pid $any) ${D}— 'bot tunnel off' không đụng vào nó${X}"
            else
                say "tunnel : ${D}tắt${X} ${D}('bot tunnel on' để mở)${X}"
            fi
            # URL chỉ hiện khi process còn sống (log cũ không in lại)
            if [ -n "$any" ] && [ -n "$url" ]; then
                say "URL    : ${BR}$url${X} ${D}→ / • /terminal/ • /download${X}"
            fi
            if [ -n "$pid" ] && [ -z "$url" ]; then
                warn "Chưa thấy địa chỉ trong log. Có thể đường hầm vẫn đang kết nối; hãy thử lại sau."
            fi
            ;;
        *) err "dùng: bot tunnel <on|off|status>"; return 1 ;;
    esac
}

open_edit() {
    local f="$1"
    [ -f "$f" ] || { err "không thấy $f"; return 1; }
    "${EDITOR:-nano}" "$f"
}
set_sh_var() { # set_sh_var <file> <KEY> <"giá trị">
    local f="$1" k="$2" v="$3" escaped replacement
    [ -f "$f" ] || { err "không thấy $f"; return 1; }
    escaped="${v//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    escaped="${escaped//\$/\\\$}"
    escaped="${escaped//\`/\\\`}"
    replacement="${escaped//\\/\\\\}"
    replacement="${replacement//&/\\&}"
    replacement="${replacement//|/\\|}"
    if grep -qE "^${k}=" "$f"; then
        sed -i "s|^${k}=.*|${k}=\"${replacement}\"|" "$f" || return 1
    else
        printf '%s="%s"\n' "$k" "$escaped" >> "$f" || return 1
    fi
    if [ "$k" = TTYD_PASS ]; then
        ok "  $k → <đã cập nhật>  ${D}($(short_path "$f"))${X}"
    else
        ok "  $k → \"$v\"  ${D}($(short_path "$f"))${X}"
    fi
}
rename_bot() { # đổi tên bot: file + tham chiếu + registry
    local old="$1" d new f
    d="$(reg_dir "$old")" || return 1
    read -r -p "Tên mới cho '$old': " new
    [ -z "$new" ] && { dim "hủy"; return 1; }
    [ "$new" = "$old" ] && { dim "trùng tên cũ"; return 1; }
    case "$new" in *[\ /]*|*_tmux|*_backup|test_*) err "tên không hợp lệ"; return 1 ;; esac
    if [ -n "$(sess_of "$old")" ]; then
        warn "'$old' đang chạy → nên stop trước khi đổi tên"
        confirm "Stop '$old' bây giờ?" && stop_one "$old"
    fi
    confirm "Đổi '$old' → '$new'?" || return 1
    for f in "$d/$old.sh" "$d/${old}_tmux.sh" "$d/$old.ini"; do
        [ -e "$f" ] || continue
        local nf="${f/$old/$new}"
        mv -v "$f" "$nf" | sed 's/^/  /'
    done
    for f in "$PROJECT_DIR/scripts/login_$old.txt" "$d/../scripts/login_$old.txt"; do
        [ -f "$f" ] && mv -v "$f" "${f/$old/$new}" | sed 's/^/  /'
    done
    # sửa tham chiếu bên trong (nhắm đúng các mẫu, không đụng account/server)
    for f in "$d/$new.sh" "$d/${new}_tmux.sh" "$d/$new.ini"; do
        [ -f "$f" ] || continue
        sed -i -E \
            -e "s/mc_${old}([^a-zA-Z0-9_]|$)/mc_${new}\1/g" \
            -e "s/${old}_tmux\.sh/${new}_tmux.sh/g" \
            -e "s/${old}_runtime\.ini/${new}_runtime.ini/g" \
            -e "s|(^|/)${old}\.ini|\1${new}.ini|g" \
            -e "s|(^|/)${old}\.sh|\1${new}.sh|g" \
            -e "s/login_${old}/login_${new}/g" \
            "$f"
    done
    reg_set "$new" "$d"; reg_del "$old"; reg_save
    ok "đã đổi tên '$old' → '$new' ${D}(kiểm tra lại ACCOUNT/SERVER bằng 'bot info $new')${X}"
}
edit_one() {
    local b="$1" d sh tsh ini login
    d="$(reg_dir "$b")" || { err "không có bot '$b'"; return 1; }
    sh="$d/$b.sh"; tsh="$d/${b}_tmux.sh"; ini="$(bot_ini "$b" 2>/dev/null)"; login="$(bot_login "$b" 2>/dev/null)"
    local ch cur
    while true; do
        say ""
        say "${BR}═══ EDIT $b ═══${X}"
        say "  1) Account        : ${M}$(bot_account "$b")${X}"
        say "  2) Server         : ${C}$(bot_server "$b")${X}"
        say "  3) INI path       : ${D}$(short_path "${ini:-?}")${X}"
        say "  4) Sửa INI        : ${D}${EDITOR:-nano} $(short_path "${ini:-?}")${X}"
        say "  5) Sửa login      : ${D}${EDITOR:-nano} $(short_path "${login:-?}")${X}"
        say "  6) TTYD user/pass : ${D}$(ttyd_user_for "$b" 2>/dev/null)${X}"
        say "  7) Ports          : web=$(port_of "$tsh" PORT "$DL_PORT") ttyd=$(port_of "$tsh" TTYD_PORT "$DEFAULT_TTYD_PORT")"
        say "  8) Đổi tên bot"
        say "  9) Sửa $b.sh     ${D}(editor)${X}"
        say " 10) Sửa ${b}_tmux.sh ${D}(editor)${X}"
        say "  0) Thoát"
        read -r -p "chọn: " ch
        case "$ch" in
            1) read -r -p "Account mới [$(bot_account "$b")]: " cur
               [ -n "$cur" ] && set_sh_var "$sh" ACCOUNT "$cur" ;;
            2) read -r -p "Server mới [$(bot_server "$b")]: " cur
               [ -n "$cur" ] && set_sh_var "$sh" SERVER "$cur" ;;
            3) [ -f "$ini" ] || { err "không có INI"; continue; }
               read -r -p "INI_SRC mới (đường dẫn, Enter=giữ): " cur
               [ -n "$cur" ] && set_sh_var "$sh" INI_SRC "$cur" ;;
            4) [ -n "$ini" ] && open_edit "$ini" ;;
            5) if [ -n "$login" ]; then open_edit "$login"; else warn "chưa có login script"; fi ;;
            6) [ -f "$tsh" ] || { err "không có $tsh"; continue; }
               read -r -p "TTYD user [$(ttyd_user_for "$b")]: " cur
               [ -n "$cur" ] && set_sh_var "$tsh" TTYD_USER "$cur"
               read -r -p "TTYD pass [***]: " cur
               [ -n "$cur" ] && set_sh_var "$tsh" TTYD_PASS "$cur" ;;
            7) [ -f "$tsh" ] || { err "không có $tsh"; continue; }
               read -r -p "Port web mới (Enter=giữ): " cur
               if [ -n "$cur" ]; then
                   [[ "$cur" =~ ^[0-9]+$ ]] && [ "$cur" -ge 1 ] && [ "$cur" -le 65535 ] \
                       && set_sh_var "$tsh" PORT "$cur" || err "port không hợp lệ"
               fi
               read -r -p "Port ttyd mới (Enter=giữ): " cur
               if [ -n "$cur" ]; then
                   [[ "$cur" =~ ^[0-9]+$ ]] && [ "$cur" -ge 1 ] && [ "$cur" -le 65535 ] \
                       && set_sh_var "$tsh" TTYD_PORT "$cur" || err "port không hợp lệ"
               fi ;;
            8) rename_bot "$b" && break ;;
            9) open_edit "$sh" ;;
            10) [ -f "$tsh" ] && open_edit "$tsh" || err "không có $tsh" ;;
            0|"") break ;;
            *) say "chọn 0-10" ;;
        esac
    done
    dim "Đã đóng phần chỉnh sửa. Nếu bot đang chạy, dùng 'bot restart $b' để áp dụng thay đổi."
}
cmd_edit() {
    if [ ! -t 0 ]; then err "'edit' cần terminal tương tác"; return 1; fi
    reg_load
    local targets=("$@")
    if [ ${#targets[@]} = 0 ]; then
        if [ "${#REG_NAMES[@]}" = 1 ]; then targets=("${REG_NAMES[@]}")
        else err "dùng: bot edit <bot|all>"; cmd_list; return 1; fi
    fi
    local n
    for n in "${targets[@]}"; do
        if [ "$n" = all ]; then local m; for m in "${REG_NAMES[@]}"; do edit_one "$m"; done
        else edit_one "$n"; fi
    done
}

cmd_attach() {
    local n="$1" s
    if [ -z "$n" ]; then
        if tmux has-session -t "=$SHARED_SESSION" 2>/dev/null; then
            exec tmux attach-session -t "$SHARED_SESSION"
        fi
        err "dùng: bot attach <bot>"; return 1
    fi
    s="$(sess_of "$n")" || { err "'$n' không chạy ('bot start $n' trước)"; return 1; }
    case "$s" in
        *:*) tmux select-window -t "$s" 2>/dev/null; tmux attach-session -t "${s%%:*}" ;;
        *)   tmux attach-session -t "$s" ;;
    esac
}

cmd_autostart() {
    local action="$1" name="$2" dir root script unit unit_path tmux_bin
    [ -n "$action" ] && [ -n "$name" ] || { err "dùng: bot autostart <on|off> <tên>"; return 2; }
    case "$action" in on|off) ;; *) err "chọn on hoặc off"; return 2;; esac
    dir="$(reg_dir "$name")" || { err "không tìm thấy bot '$name'"; return 1; }
    script="$dir/${name}_tmux.sh"
    [ -f "$script" ] || script="$dir/${name}.sh"
    [ -f "$script" ] || { err "không tìm thấy script chạy bot '$name'"; return 1; }
    unit="mc-$name.service"
    unit_path="$HOME/.config/systemd/user/$unit"
    if [ "$action" = on ]; then
        command -v systemctl >/dev/null 2>&1 || { err "máy không có systemctl"; return 1; }
        tmux_bin="$(command -v tmux)" || { err "chưa cài tmux"; return 1; }
        root="$(cd "$dir/.." && pwd)"
        mkdir -p "$HOME/.config/systemd/user"
        cat > "$unit_path" <<EOF
[Unit]
Description=KingMC AFK bot $name
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory="$root"
ExecStart=/bin/bash "$script" --bg
ExecStop=-$tmux_bin kill-window -t mc_bot:$name
[Install]
WantedBy=default.target
EOF
        systemctl --user daemon-reload && systemctl --user enable "$unit" \
            || { err "không bật được tự khởi động cho '$name'"; return 1; }
        loginctl enable-linger "$(id -un)" >/dev/null 2>&1 \
            || warn "không bật được linger; bot sẽ tự chạy khi người dùng đăng nhập"
        ok "tự khởi động đã bật cho '$name'"
    else
        systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
        rm -f "$unit_path"
        systemctl --user daemon-reload
        ok "tự khởi động đã tắt cho '$name'"
    fi
}

cmd_doctor() {
    reg_load
    local bad=0 d f
    say "${BR}═══ doctor ═══${X}"
    # deps
    for c in tmux ss python3 pgrep; do
        command -v "$c" >/dev/null 2>&1 && ok "$c: có" || { err "$c: THIẾU"; bad=1; }
    done
    # registry
    [ -f "$REG_FILE" ] && ok "registry: $(short_path "$REG_FILE") (${#REG_NAMES[@]} bot)" \
        || { warn "chưa có registry (sẽ tự tạo khi seed)"; }
    local n
    for n in "${REG_NAMES[@]}"; do
        d="$(reg_dir "$n")"
        [ -d "$d" ] || { err "$n: thư mục không tồn tại $d"; bad=1; continue; }
        [ -f "$d/$n.sh" ] || { err "$n: thiếu $d/$n.sh"; bad=1; }
        f="$(bot_ini "$n" 2>/dev/null)"
        [ -n "$f" ] || warn "$n: không tìm thấy INI"
    done
    # session mồ côi (mc_* không thuộc bot nào)
    local s orph=""
    for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep -E '^mc_'); do
        [ "$s" = "$SHARED_SESSION" ] && continue
        reg_has "${s#mc_}" || orph="$orph $s"
    done
    [ -n "$orph" ] && warn "tmux mồ côi:$orph (bot stop -a để dọn)" || ok "tmux: không có session mồ côi"
    # systemd cũ
    for f in /etc/systemd/system/mc-*.service "$HOME/.config/systemd/user/"mc-*.service; do
        [ -e "$f" ] || continue
        s="$(basename "$f" .service)"; s="${s#mc-}"
        reg_has "$s" || warn "unit systemd cũ: $f (bot không nằm trong registry)"
    done
    # hạ tầng
    if [ -n "$(dl_pid)" ]; then ok "web 1-port :$DL_PORT: chạy (pid $(dl_pid))"
    else dim "web 1-port :$DL_PORT: tắt"; fi
    local tpid
    tpid="$(tunnel_pid)"; [ -z "$tpid" ] && tpid="$(tunnel_pid_any)"
    if [ -n "$tpid" ]; then ok "tunnel: chạy (pid $tpid) $(tunnel_url)"
    else dim "tunnel: tắt ('bot tunnel on' để mở)"; fi
    [ "$bad" = 0 ] && ok "doctor: mọi thứ ổn" || err "doctor: có vấn đề (xem above)"
}

# ============================================================================
#  MAIN
# ============================================================================
cmd="${1:-}"; [ $# -gt 0 ] && shift

case "$cmd" in
    ""|help|-h|--help|h|\?|-help)
        reg_load; registry_seed
        if [ -z "$cmd" ]; then
            # không đối số: 1 bot → start, nhiều → list
            if [ "${#REG_NAMES[@]}" = 1 ]; then
                say "${D}[hint] không có lệnh → start bot duy nhất${X}"
                exec "$0" start "${REG_NAMES[0]}"
            fi
            cmd_list
        else
            cmd_help
        fi
        ;;
    version|--version|-v) echo "bot $BOT_VERSION" ;;
    list|ls|l)
        reg_load; registry_seed; cmd_list ;;
    status|st|stat)
        reg_load; registry_seed; cmd_status "$@" ;;
    info)
        reg_load; registry_seed; cmd_info "$@" ;;
    start|run)
        reg_load; registry_seed; cmd_start "$@" ;;
    stop|kill)
        reg_load; registry_seed; cmd_stop "$@" ;;
    restart|rst)
        reg_load; registry_seed; cmd_restart "$@" ;;
    autostart)
        reg_load; registry_seed; cmd_autostart "$@" ;;
    tunnel|tn)
        reg_load; cmd_tunnel "$@" ;;
    add)
        reg_load; registry_seed; cmd_add "$@" ;;
    remove|rm|del|delete)
        reg_load; registry_seed; cmd_remove "$@" ;;
    download|dl)
        reg_load; cmd_download "$@" ;;
    edit)
        reg_load; registry_seed; cmd_edit "$@" ;;
    attach|ta)
        reg_load; registry_seed; cmd_attach "$@" ;;
    doctor|check)
        reg_load; registry_seed; cmd_doctor ;;
    *)
        reg_load; registry_seed
        if reg_has "$cmd"; then
            say "${D}[hint] 'bot $cmd' = 'bot start $cmd'${X}"
            exec "$0" start "$cmd" "$@"
        fi
        err "lệnh không hiểu: '$cmd'"
        say ""
        dim "  xem trợ giúp: bot help   •   danh sách: bot ls"
        exit 1 ;;
esac
