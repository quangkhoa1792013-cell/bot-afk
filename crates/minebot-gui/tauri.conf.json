{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineBot",
  "version": "0.1.0",
  "identifier": "app.minebot.desktop",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MineBot Control Panel",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
