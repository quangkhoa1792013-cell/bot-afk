{
  "name": "bot-mail",
  "version": "1.0.0",
  "description": "Self-hosted temporary email receiver: SMTP catch-all + OTP extractor + Telegram notify + Web dashboard",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "test": "node test/smoke.js",
    "test:profile": "node test/profile-smoke.js",
    "test:send": "node test/send-sample.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/smtp-server": "^3.5.10",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1"
  }
}
